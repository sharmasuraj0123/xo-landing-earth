# Clerk auth. In local dev the app runs in Clerk keyless mode without these:
# the dev server prints a claim link, and you can copy real keys from
# https://dashboard.clerk.com once you claim the instance.
# Production builds require both keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/blog
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/blog
